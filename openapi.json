{
  "openapi": "3.1.0",
  "info": {
    "title": "Networking App - Business Card OCR Backend API",
    "description": "Backend API for retrieving business card data via Roboflow OCR, storing in database, ignoring duplicate records, and keeping contacts categorized by role.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/contacts/extract-url": {
      "post": {
        "tags": [
          "Contacts & OCR"
        ],
        "summary": "Extract Contact From Url",
        "description": "Extract contact details from image URL via Roboflow OCR Workflow.\nExtracted data is categorized by role and saved to SQLite DB.\nIf contact already exists (duplicate email/phone), duplicate insertion is ignored.",
        "operationId": "extract_contact_from_url_api_contacts_extract_url_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractURLRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractOCRResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/contacts/extract-file": {
      "post": {
        "tags": [
          "Contacts & OCR"
        ],
        "summary": "Extract Contact From File",
        "description": "Extract contact details from uploaded image file via Roboflow OCR Workflow.\nExtracted data is categorized by role and saved to SQLite DB.\nIf contact already exists (duplicate email/phone), duplicate insertion is ignored.",
        "operationId": "extract_contact_from_file_api_contacts_extract_file_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_extract_contact_from_file_api_contacts_extract_file_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractOCRResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
